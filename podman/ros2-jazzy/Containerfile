FROM docker.io/library/ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    git \
    iproute2 \
    ros-jazzy-action-tutorials-interfaces \
    ros-jazzy-demo-nodes-cpp \
    ros-jazzy-example-interfaces \
  && rm -rf /var/lib/apt/lists/*

# Keep this aligned with the MoonBit toolchain in flake.lock. The `latest`
# selector moves independently of the flake and can break the interop tests.
ARG MOONBIT_VERSION=0.10.21+06da1ed44
RUN curl -fsSL https://cli.moonbitlang.com/install/unix.sh | bash -s -- "${MOONBIT_VERSION}"

ENV PATH="/root/.moon/bin:${PATH}"
