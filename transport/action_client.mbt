///|
/// A ROS 2 action client composed from its three service clients and two
/// reliable topic subscriptions. Action-specific request/response payloads
/// remain generated by `rosidl` and are passed as CDR bytes.
pub struct RosActionClient {
  send_goal_client : RosServiceClient
  get_result_client : RosServiceClient
  cancel_goal_client : RosServiceClient
  feedback_subscription : ReliableRosSubscription
  status_subscription : ReliableRosSubscription
}

///|
/// Combine the five transport endpoints for one ROS 2 action client.
pub fn RosActionClient::new(
  action : @ros.RosAction,
  send_goal_client : RosServiceClient,
  get_result_client : RosServiceClient,
  cancel_goal_client : RosServiceClient,
  feedback_subscription : ReliableRosSubscription,
  status_subscription : ReliableRosSubscription,
) -> Result[RosActionClient, String] {
  if send_goal_client.service() != action.send_goal_service() ||
    get_result_client.service() != action.get_result_service() ||
    cancel_goal_client.service() != action.cancel_goal_service() {
    return Err("the action service clients do not match the action descriptor")
  }
  let feedback_topic = feedback_subscription.topic()
  if feedback_topic.dds_name() != action.feedback_topic().dds_name() ||
    feedback_topic.dds_type_name() != action.feedback_topic().dds_type_name() {
    return Err("the action feedback subscription does not match the action")
  }
  let status_topic = status_subscription.topic()
  if status_topic.dds_name() != action.status_topic().dds_name() ||
    status_topic.dds_type_name() != action.status_topic().dds_type_name() {
    return Err("the action status subscription does not match the action")
  }
  if send_goal_client.shared_socket != get_result_client.shared_socket ||
    send_goal_client.shared_socket != cancel_goal_client.shared_socket {
    return Err("the action service clients must use the same socket mode")
  }
  Ok({
    send_goal_client,
    get_result_client,
    cancel_goal_client,
    feedback_subscription,
    status_subscription,
  })
}

///|
/// Send a generated action-specific SendGoal request and return its response.
pub async fn RosActionClient::request_send_goal(
  self : RosActionClient,
  serialized_request : Bytes,
) -> Result[Bytes, String] {
  ros_action_client_request(self.send_goal_client, serialized_request)
}

///|
/// Send a generated action-specific GetResult request and return its response.
pub async fn RosActionClient::request_get_result(
  self : RosActionClient,
  serialized_request : Bytes,
) -> Result[Bytes, String] {
  ros_action_client_request(self.get_result_client, serialized_request)
}

///|
/// Request cancellation of one goal and decode the standard ROS response.
pub async fn RosActionClient::request_cancel_goal(
  self : RosActionClient,
  goal_id : Bytes,
) -> Result[@ros.RosCancelGoalResponse, String] {
  let goal_info = match @ros.RosActionGoalInfo::new(goal_id, 0, 0U) {
    Ok(value) => value
    Err(message) => return Err(message)
  }
  let request = @ros.RosCancelGoalRequest::new(goal_info)
  let payload = match
    ros_action_client_request(self.cancel_goal_client, request.to_cdr_bytes()) {
    Ok(value) => value
    Err(message) => return Err(message)
  }
  @ros.RosCancelGoalResponse::from_cdr_bytes(payload)
}

///|
/// Receive the next feedback sample for `goal_id` as generated CDR bytes.
pub async fn RosActionClient::receive_feedback(
  self : RosActionClient,
  goal_id : Bytes,
) -> Result[Bytes, String] {
  if goal_id.length() != 16 {
    return Err("an action goal ID must contain exactly 16 bytes")
  }
  while true {
    let (payload, _) = match self.feedback_subscription.receive() {
      Ok(value) => value
      Err(message) => return Err(message)
    }
    let reader = match @cdr.Reader::from_bytes(payload) {
      Ok(value) => value
      Err(message) => return Err(message)
    }
    let received_goal_id = match reader.read_byte_array(16) {
      Ok(value) => value
      Err(message) => return Err(message)
    }
    if received_goal_id == goal_id {
      return Ok(payload)
    }
  }
  Err("action feedback receive loop stopped")
}

///|
/// Receive the next status entry for `goal_id` from GoalStatusArray samples.
pub async fn RosActionClient::receive_next_goal_status(
  self : RosActionClient,
  goal_id : Bytes,
) -> Result[@ros.RosActionGoalStatus, String] {
  if goal_id.length() != 16 {
    return Err("an action goal ID must contain exactly 16 bytes")
  }
  while true {
    let (payload, _) = match self.status_subscription.receive() {
      Ok(value) => value
      Err(message) => return Err(message)
    }
    let status_array = match
      @ros.RosActionGoalStatusArray::from_cdr_bytes(payload) {
      Ok(value) => value
      Err(message) => return Err(message)
    }
    for goal_status in status_array.status_list() {
      if goal_status.goal_info().goal_id() == goal_id {
        return Ok(goal_status)
      }
    }
  }
  Err("GoalStatusArray receive loop stopped")
}

///|
/// Wait until `goal_id` reaches Succeeded, Canceled, or Aborted.
pub async fn RosActionClient::receive_terminal_goal_status(
  self : RosActionClient,
  goal_id : Bytes,
) -> Result[@ros.RosActionGoalStatus, String] {
  while true {
    let status = match self.receive_next_goal_status(goal_id) {
      Ok(value) => value
      Err(message) => return Err(message)
    }
    if status.is_terminal() {
      return Ok(status)
    }
  }
  Err("GoalStatusArray receive loop stopped before a terminal status")
}

///|
/// Receive statuses for `goal_id` until `expected_status` is published.
pub async fn RosActionClient::receive_goal_status(
  self : RosActionClient,
  goal_id : Bytes,
  expected_status : Int,
) -> Result[@ros.RosActionGoalStatus, String] {
  while true {
    let status = match self.receive_next_goal_status(goal_id) {
      Ok(value) => value
      Err(message) => return Err(message)
    }
    if status.status() == expected_status {
      return Ok(status)
    }
  }
  Err("GoalStatusArray receive loop stopped")
}

///|
/// Close the action clients and their reliable topic subscriptions.
pub fn RosActionClient::close(self : RosActionClient) -> Unit {
  if self.send_goal_client.shared_socket {
    // All shared-socket service clients own the same user socket.
    self.send_goal_client.close()
  } else {
    self.send_goal_client.close()
    self.get_result_client.close()
    self.cancel_goal_client.close()
  }
  self.feedback_subscription.close()
  self.status_subscription.close()
}

///|
async fn ros_action_client_request(
  client : RosServiceClient,
  serialized_request : Bytes,
) -> Result[Bytes, String] {
  let identity = match client.request(serialized_request) {
    Ok(value) => value
    Err(message) => return Err(message)
  }
  let (payload, _) = match client.receive_response(identity) {
    Ok(value) => value
    Err(message) => return Err(message)
  }
  Ok(payload)
}
