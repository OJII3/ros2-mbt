import {
  "OJII3/ros2-mbt/cdr",
  "OJII3/ros2-mbt/examples/config",
  "OJII3/ros2-mbt/ros",
  "OJII3/ros2-mbt/rtps",
  "OJII3/ros2-mbt/transport",
  "moonbitlang/core/async",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/socket",
}

supported_targets = "native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/aqueue",
    "moonbitlang/core/async/socket",
  ],
)

pkgtype(kind: "executable")
