///|
/// Generated string constants using escaped MoonBit literals.
pub const SINGLE : String = "single quoted"

///|
/// String constant without quotation marks in the source definition.
pub const RAW : String = "unquoted value"

///|
/// String constant containing an escaped quotation mark.
pub const ESCAPED : String = "say \"hi\""

///|
/// Unicode string constant.
pub const UNICODE : String = "猫"
