///|
/// Generated floating-point constants using exponent notation.
pub const SMALL : Float = 1.25e-3F

///|
/// Whole-valued floating-point constant.
pub const WHOLE : Float = 1.0F

///|
/// Large negative floating-point constant.
pub const LARGE : Double = -2.0e+9

///|
/// Floating-point constant with a leading fractional digit.
pub const LEADING : Double = 0.5

///|
/// Floating-point constant with trailing fractional zeros.
pub const TRAILING : Double = 1.0

///|
/// Grouped floating-point constant using exponent notation.
pub const GROUPED : Double = 1000.5e+2
